# Hafez System production environment template.
# Copy to .env, replace every placeholder, and never commit the resulting file.

APP_NAME="Hafez System"
APP_ENV=production
# Required: generate with php artisan key:generate --show and keep secret.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Production database connection.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_with_production_database
DB_USERNAME=replace_with_production_user
DB_PASSWORD=replace_with_production_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Local development uses the database queue and runs the worker.
QUEUE_CONNECTION=database
CACHE_STORE=database
# InfinityFree deployments must use QUEUE_CONNECTION=sync and should use the
# file session/cache drivers. See deployment/infinityfree/.env.example.

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="Hafez System"
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=3
OTP_REQUEST_DECAY_MINUTES=10

# Optional Redis configuration.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Optional object storage configuration when FILESYSTEM_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Hafez System"

# Required before running: php artisan db:seed --class=AdminUserSeeder --force
HAFEZ_ADMIN_NAME=
HAFEZ_ADMIN_EMAIL=
HAFEZ_ADMIN_PHONE=
HAFEZ_ADMIN_PASSWORD=

# Local/testing QA fixture only. Never set these in production.
HAFEZ_QA_EMAIL=qa.organizer@example.test
HAFEZ_QA_PASSWORD=
